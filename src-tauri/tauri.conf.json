{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "app-lifelog",
  "version": "0.1.0",
  "identifier": "app.lifelog",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "生活数据库",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "visible": false
      },
      {
        "label": "quick",
        "title": "快捷输入",
        "url": "quick.html",
        "width": 420,
        "height": 300,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
