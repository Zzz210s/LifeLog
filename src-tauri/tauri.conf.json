{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾枝",
  "mainBinaryName": "LifeLog",
  "version": "0.1.0",
  "identifier": "com.lifelog.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "input",
        "title": "输入栏",
        "url": "input.html",
        "width": 420,
        "height": 300,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
