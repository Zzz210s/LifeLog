  "cards": [
    {
      "dot": "cyan",
      "title": "Two windows, one shared layer",
      "items": [
        "index.html hosts the main notes stream; quick.html hosts the capture window",
        "src/shared/api.ts wraps every Tauri command; markdown.ts renders through DOMPurify"
      ]
    },
    {
      "dot": "emerald",
      "title": "Thin Rust command layer",
      "items": [
        "notes, settings, exchange and windowing commands each delegate to one domain module",
        "save_quick_note emits note-created so the main window refreshes itself"
      ]
    },
    {
      "dot": "violet",
      "title": "Domain and data",
      "items": [
        "db/repos owns queries, tags.rs tokenises #tags, exchange builds the Excel bytes",
        "One shared Mutex<Connection>; SQLite triggers keep notes_fts (FTS5 trigram) in sync"
      ]
    }
