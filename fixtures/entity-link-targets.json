{
  "why": "[[标题]] 目标裁决(D6):先在 entities.name 命中标签(同类取 id 最小),再在笔记首行命中(同类取 id 最小);标签优先;都没命中 = 未解析。TS 与 Rust 两侧读同一份:entity-link-targets.test.ts / note_link_fixtures_tests.rs。",
  "entities": [
    { "id": 1, "kind": "note", "content": "目标笔记" },
    { "id": 2, "kind": "note", "content": "同名" },
    { "id": 3, "kind": "note", "content": "同名" },
    { "id": 4, "kind": "note", "content": "撞名" },
    { "id": 5, "kind": "note", "content": "源自己" },
    { "id": 6, "kind": "note", "content": "Hello   World\n第二行" },
    { "id": 7, "kind": "note", "content": "\n\n  真正首行  \n" },
    { "id": 1000000001, "kind": "tag", "name": "日本" },
    { "id": 1000000002, "kind": "tag", "name": "日本" },
    { "id": 1000000003, "kind": "tag", "name": "撞名" },
    { "id": 1000000004, "kind": "tag", "name": "SQL" }
  ],
  "cases": [
    { "why": "笔记首行命中(等值)", "rawTitle": "目标笔记", "expect": 1 },
    { "why": "笔记首行跳前导空行 + 裁空白", "rawTitle": "真正首行", "expect": 7 },
    { "why": "折叠连续空白后命中笔记", "rawTitle": "Hello World", "expect": 6 },
    { "why": "大小写折叠后命中笔记", "rawTitle": "hello world", "expect": 6 },
    { "why": "标签 name 命中(不分大小写)", "rawTitle": "sql", "expect": 1000000004 },
    { "why": "标签同名取 id 最小", "rawTitle": "日本", "expect": 1000000001 },
    { "why": "笔记同名取 id 最小", "rawTitle": "同名", "expect": 2 },
    { "why": "双端同名:标签优先于笔记", "rawTitle": "撞名", "expect": 1000000003 },
    { "why": "自指跳过(无同名他人)", "rawTitle": "源自己", "exclude": 5, "expect": null },
    { "why": "自指但另有同名笔记:指向他人", "rawTitle": "同名", "exclude": 2, "expect": 3 },
    { "why": "都没命中 = 未解析", "rawTitle": "不存在的标题", "expect": null },
    { "why": "归一化后为空 = 未解析", "rawTitle": "   ", "expect": null }
  ]
}
