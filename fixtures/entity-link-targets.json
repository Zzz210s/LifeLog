{
  "why": "统一元数据后 [[标题]] 的目标裁决(spec 2026-10-08 §5.1 / P5):唯一匹配键 = entity_key(meta)(首行归一化),同键取 id 最小;不再有「标签优先 / 笔记优先」的种类分流,path 只是显示缓存、不参与匹配。同一份向量两侧各跑一遍:src/shared/entity-link-targets.test.ts(TS resolveLinkTarget)/ src-tauri/src/note_link_fixtures_tests.rs(Rust resolve_target)。",
  "entities": [
    { "id": 101, "meta": "目标笔记" },
    { "id": 102, "meta": "同名" },
    { "id": 103, "meta": "同名" },
    { "id": 104, "meta": "撞名" },
    { "id": 105, "meta": "撞名" },
    { "id": 106, "meta": "源自己" },
    { "id": 107, "meta": "Hello   World\n第二行" },
    { "id": 108, "meta": "\n\n  真正首行  \n" },
    { "id": 109, "meta": "日本" },
    { "id": 110, "meta": "日本" },
    { "id": 111, "meta": "SQL" },
    { "id": 112, "meta": "甲/乙", "path": "显示缓存/甲/乙" }
  ],
  "cases": [
    { "why": "笔记首行命中(等值)", "rawTitle": "目标笔记", "expect": 101 },
    { "why": "前导空行 + 裁空白后命中", "rawTitle": "真正首行", "expect": 108 },
    { "why": "折叠连续空白后命中", "rawTitle": "Hello World", "expect": 107 },
    { "why": "大小写折叠后命中", "rawTitle": "hello world", "expect": 107 },
    { "why": "单段名命中(不分大小写)", "rawTitle": "sql", "expect": 111 },
    { "why": "同键取 id 最小", "rawTitle": "日本", "expect": 109 },
    { "why": "同名两实体取 id 最小", "rawTitle": "同名", "expect": 102 },
    { "why": "同键三实体仍取 id 最小", "rawTitle": "撞名", "expect": 104 },
    { "why": "名字含 / 也按 entity_key 命中(不按 path)", "rawTitle": "甲/乙", "expect": 112 },
    { "why": "path 缓存不是匹配键:拿路径当标题找不到", "rawTitle": "显示缓存/甲/乙", "expect": null },
    { "why": "自指跳过(无同名他人)", "rawTitle": "源自己", "exclude": 106, "expect": null },
    { "why": "自指但另有同键实体:指向他人", "rawTitle": "同名", "exclude": 102, "expect": 103 },
    { "why": "都没命中 = 未解析", "rawTitle": "不存在的标题", "expect": null },
    { "why": "归一化后为空 = 未解析", "rawTitle": "   ", "expect": null }
  ]
}
