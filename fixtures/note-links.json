    { "name": "空显示回退成无别名", "content": "[[甲|]]", "expect": ["甲"], "expectDisplay": [null] },
    { "name": "空目标整串不算", "content": "[[|乙]]", "expect": [], "expectDisplay": [] },
    { "name": "别名首尾空白裁掉", "content": "[[甲|  乙  ]]", "expect": ["甲"], "expectDisplay": ["乙"] },
    {
      "name": "围栏里带别名不算",
      "content": "```\n[[甲|乙]]\n```",
      "expect": [],
      "expectDisplay": []
    }
  ],
  "titles": [
    { "name": "普通", "content": "今天聚会\n#日记", "expect": "今天聚会" },
    { "name": "首行含标签词元", "content": "聚会 #日记\n第二行", "expect": "聚会" },
    { "name": "折叠空白与大小写", "content": "Hello   World\nx", "expect": "hello world" },
