    { "name": "围栏里不算", "content": "```\n[[甲]]\n```", "expect": [] },
    { "name": "行内代码里不算", "content": "`[[甲]]`", "expect": [] },
    { "name": "转义不算", "content": "\\[[甲]]", "expect": [] },
    { "name": "嵌套整串不算", "content": "[[甲[[乙]]", "expect": [] },
    { "name": "空不算", "content": "[[]]", "expect": [] },
    { "name": "跨行不算", "content": "[[甲\n乙]]", "expect": [] },
    { "name": "首尾空白裁掉", "content": "[[  甲  ]]", "expect": ["甲"] },
    { "name": "标签形不算", "content": "参考 [[#工作/]]", "expect": [] },
    { "name": "标签形双斜杠不算", "content": "参考 [[#a//b]]", "expect": [] },
    { "name": "别名", "content": "看 [[甲|乙]] 那条", "expect": ["甲"], "expectDisplay": ["乙"] },
    {
      "name": "多个竖线只在第一个切分",
      "content": "[[甲|乙|丙]]",
      "expect": ["甲"],
      "expectDisplay": ["乙|丙"]
