{
  "note": "应用内快捷键规范化的共享向量。cases = 键名片段 -> 规范化加速键(小写,修饰键序 ctrl/alt/shift/super),与 src-tauri/src/hotkey_spec.rs 的 validate 同规则;mainKeys = 插件解析器(global-hotkey 0.8 parse_key)认识的**全部**规范主键名,TS(hotkey-keys.ts)与 Rust(hotkey_fixtures_tests.rs)两侧都读它做漂移探测;events = DOM 事件面(TS 独有:Rust 没有 KeyboardEvent)。normalized 为 null 表示非法(key 数 1-3、单键仅 F1-F24、单主键、主键名必须在 mainKeys 里)。",
  "cases": [
    {
      "why": "修饰键按 Ctrl -> Alt -> Shift -> Super 排序",
      "keys": [
        "shift",
        "ctrl",
        "p"
      ],
      "normalized": "ctrl+shift+p"
    },
    {
      "why": "主键大小写不敏感",
      "keys": [
        "ctrl",
        "shift",
        "P"
      ],
      "normalized": "ctrl+shift+p"
    },
    {
      "why": "control 是 ctrl 的别名",
      "keys": [
        "control",
        "q"
      ],
      "normalized": "ctrl+q"
    },
    {
      "why": "cmd/meta/win 都归一为 super",
      "keys": [
        "cmd",
        "space"
      ],
      "normalized": "super+space"
    },
    {
      "why": "win 同上",
      "keys": [
        "win",
        "Digit5"
      ],
      "normalized": "super+5"
    },
    {
      "why": "cmdorctrl 系列(插件别名)归一为 ctrl",
      "keys": [
        "cmdorctrl",
        "p"
      ],
      "normalized": "ctrl+p"
    },
    {
      "why": "插件别名 KeyQ -> q",
      "keys": [
        "Ctrl",
        "KeyQ"
      ],
      "normalized": "ctrl+q"
    },
    {
      "why": "单个功能键允许(F1-F24)",
      "keys": [
        "f5"
      ],
      "normalized": "f5"
    },
    {
      "why": "上界 F24 允许",
      "keys": [
        "f24"
      ],
      "normalized": "f24"
    },
    {
      "why": "单键必须功能键:普通字母拒绝",
      "keys": [
        "a"
      ],
      "normalized": null
    },
    {
      "why": "单键必须功能键:数字拒绝",
      "keys": [
        "5"
      ],
      "normalized": null
    },
    {
      "why": "3 键组合须含修饰键:两个主键拒绝",
      "keys": [
        "ctrl",
        "p",
        "q"
      ],
      "normalized": null
    },
    {
      "why": "只有修饰键不算组合",
      "keys": [
        "ctrl",
        "alt"
      ],
      "normalized": null
    },
    {
      "why": "超过 3 个键拒绝",
      "keys": [
        "ctrl",
        "shift",
        "alt",
        "p"
      ],
      "normalized": null
    },
    {
      "why": "空输入拒绝",
      "keys": [],
      "normalized": null
    },
    {
      "why": "F25 超出单键范围",
      "keys": [
        "f25"
      ],
      "normalized": null
    },
    {
      "why": "重复修饰键去重后仍是 2 键组合",
      "keys": [
        "ctrl",
        "ctrl",
        "p"
      ],
      "normalized": "ctrl+p"
    },
    {
      "why": "修饰键 + 功能键",
      "keys": [
        "shift",
        "f5"
      ],
      "normalized": "shift+f5"
    },
    {
      "why": "命名键保留规范名",
      "keys": [
        "ctrl",
        "escape"
      ],
      "normalized": "ctrl+escape"
    },
    {
      "why": "未知主键名(原 11 条分歧 A 组):TS 与 Rust 必须一致拒绝",
