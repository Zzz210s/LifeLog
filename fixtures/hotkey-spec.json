{
  "note": "应用内快捷键规范化的共享向量。cases = 键名片段 -> 规范化加速键(小写,修饰键序 ctrl/alt/shift/super),与 src-tauri/src/hotkey_spec.rs 的 validate 同规则,Rust 侧镜像后续任务读同一段;events = DOM 事件面(TS 独有:Rust 没有 KeyboardEvent)。normalized 为 null 表示非法(key 数 1-3、单键仅 F1-F24、单主键)。",
  "cases": [
    { "why": "修饰键按 Ctrl -> Alt -> Shift -> Super 排序", "keys": ["shift", "ctrl", "p"], "normalized": "ctrl+shift+p" },
    { "why": "主键大小写不敏感", "keys": ["ctrl", "shift", "P"], "normalized": "ctrl+shift+p" },
    { "why": "control 是 ctrl 的别名", "keys": ["control", "q"], "normalized": "ctrl+q" },
    { "why": "cmd/meta/win 都归一为 super", "keys": ["cmd", "space"], "normalized": "super+space" },
    { "why": "win 同上", "keys": ["win", "Digit5"], "normalized": "super+5" },
    { "why": "cmdorctrl 系列(插件别名)归一为 ctrl", "keys": ["cmdorctrl", "p"], "normalized": "ctrl+p" },
    { "why": "插件别名 KeyQ -> q", "keys": ["Ctrl", "KeyQ"], "normalized": "ctrl+q" },
    { "why": "单个功能键允许(F1-F24)", "keys": ["f5"], "normalized": "f5" },
    { "why": "上界 F24 允许", "keys": ["f24"], "normalized": "f24" },
    { "why": "单键必须功能键:普通字母拒绝", "keys": ["a"], "normalized": null },
    { "why": "单键必须功能键:数字拒绝", "keys": ["5"], "normalized": null },
    { "why": "3 键组合须含修饰键:两个主键拒绝", "keys": ["ctrl", "p", "q"], "normalized": null },
    { "why": "只有修饰键不算组合", "keys": ["ctrl", "alt"], "normalized": null },
    { "why": "超过 3 个键拒绝", "keys": ["ctrl", "shift", "alt", "p"], "normalized": null },
    { "why": "空输入拒绝", "keys": [], "normalized": null },
    { "why": "F25 超出单键范围", "keys": ["f25"], "normalized": null },
    { "why": "重复修饰键去重后仍是 2 键组合", "keys": ["ctrl", "ctrl", "p"], "normalized": "ctrl+p" },
    { "why": "修饰键 + 功能键", "keys": ["shift", "f5"], "normalized": "shift+f5" },
    { "why": "命名键保留规范名", "keys": ["ctrl", "escape"], "normalized": "ctrl+escape" }
  ],
  "events": [
    { "why": "Ctrl+P 命中存储值", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyP" }, "stored": "ctrl+p", "match": true },
    { "why": "多余修饰键不算命中", "event": { "ctrlKey": true, "altKey": false, "shiftKey": true, "metaKey": false, "code": "KeyP" }, "stored": "ctrl+p", "match": false },
    { "why": "少一个修饰键不算命中", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyP" }, "stored": "ctrl+shift+p", "match": false },
    { "why": "Cmd 事件映射 super 后命中", "event": { "ctrlKey": false, "altKey": false, "shiftKey": false, "metaKey": true, "code": "KeyP" }, "stored": "super+p", "match": true },
    { "why": "无修饰键的 F5 命中", "event": { "ctrlKey": false, "altKey": false, "shiftKey": false, "metaKey": false, "code": "F5" }, "stored": "f5", "match": true },
    { "why": "修饰键顺序不影响命中(存储值与事件都先规范化)", "event": { "ctrlKey": true, "altKey": true, "shiftKey": false, "metaKey": false, "code": "KeyP" }, "stored": "alt+ctrl+p", "match": true },
    { "why": "存储值大小写不一也命中(比较前规范化)", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyP" }, "stored": "CTRL+P", "match": true },
    { "why": "只按下修饰键不算命中", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "ControlLeft" }, "stored": "ctrl+p", "match": false },
    { "why": "普通单键存储值非法,永不命中", "event": { "ctrlKey": false, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyA" }, "stored": "a", "match": false },
    { "why": "存储值为空(null)时不命中", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyP" }, "stored": null, "match": false },
    { "why": "无关键不命中", "event": { "ctrlKey": true, "altKey": false, "shiftKey": false, "metaKey": false, "code": "KeyQ" }, "stored": "ctrl+p", "match": false }
  ]
}
